    "@supabase/supabase-js": "^2.119.2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/bun": "latest",
    "@types/react": "^19",
