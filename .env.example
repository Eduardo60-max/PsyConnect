# URL pública HTTPS da API Bun (obrigatória ao compilar o app Android Capacitor)
BUN_PUBLIC_API_URL=https://api.seu-dominio.com

# Supabase (cliente: URL e ANON KEY são públicas; nunca coloque SERVICE_ROLE_KEY no app)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
BUN_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
BUN_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Somente no servidor Bun (NUNCA expor no frontend/Android)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Origens permitidas no CORS (domínio do site publicado + origens do Capacitor)
CORS_ORIGINS=https://seu-site.com,capacitor://localhost,https://localhost

# E-mails com permissão de Admin separados por vírgula (aprovar médicos, moderação, CSV PANAS)
ADMIN_EMAILS=admin@seu-dominio.com

# URL de retorno opcional para links de confirmação de e-mail / recuperação de senha no app Android
# Padrão quando omitido no app nativo: com.psyconnect.app://auth-callback
BUN_PUBLIC_APP_REDIRECT_URL=com.psyconnect.app://auth-callback
